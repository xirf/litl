{
  "name": "litl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.5",
    "prettier": "^3.9.9",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tests/model.cjs && node tests/timeline.cjs && node tests/extensions.cjs && node tests/relay.cjs",
    "test:browser": "playwright test",
    "relay": "node scripts/relay.mjs",
    "format": "prettier --write app components lib scripts tests public/lilt/{model,core-pack,renderer,player,migrate,editing,index}.js *.ts",
    "format:check": "prettier --check app components lib scripts tests public/lilt/{model,core-pack,renderer,player,migrate,editing,index}.js *.ts"
  }
}
