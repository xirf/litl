{
  "name": "litl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vinext/cloudflare": "^1.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-hotkeys-hook": "^5.3.3",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.5",
    "prettier": "^3.9.9",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tests/model.cjs && node tests/timeline.cjs && node tests/extensions.cjs && node tests/visuals.cjs && node tests/relay.cjs && node tests/mcp.mjs",
    "test:browser": "playwright test",
    "relay": "node scripts/relay.mjs",
    "format": "prettier --write app components hooks lib scripts tests public/lilt/{model,core-pack,renderer,player,migrate,editing,index}.js *.ts",
    "format:check": "prettier --check app components hooks lib scripts tests public/lilt/{model,core-pack,renderer,player,migrate,editing,index}.js *.ts",
    "build:player": "tailwindcss -i styles/player.css -o public/lilt/player.css --minify",
    "prebuild": "npm run build:player",
    "predev": "npm run build:player",
    "mcp": "node scripts/mcp/server.mjs",
    "lyrics": "node scripts/lyrics.mjs"
  }
}
